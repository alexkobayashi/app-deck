<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP em texto claro é permitido de propósito.

  O servidor do App Deck roda na rede local com um IP que o usuário digita ou
  escaneia por QR code. Não dá para restringir por <domain-config>, porque
  essa configuração não aceita faixas de IP (CIDR) — só nomes de host
  específicos, que aqui não existem.

  O tráfego fica confinado à LAN e é autenticado por token no header. Quando
  o servidor ganhar HTTPS com certificado autoassinado, isto vira
  cleartextTrafficPermitted="false" com <certificates src="@raw/deck_ca" />.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      InsecureBaseConfiguration é suprimido conscientemente: é exatamente
      isto que o app precisa fazer, pelos motivos acima.
    -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
